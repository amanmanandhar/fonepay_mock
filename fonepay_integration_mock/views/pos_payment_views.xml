<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="pos_payment_fonepay_form" model="ir.ui.view">
        <field name="name">pos.payment.fonepay.form</field>
        <field name="model">pos.payment.method</field>
        <field name="inherit_id" ref="point_of_sale.pos_payment_method_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group" position="inside">
            <group>
                <field name="use_fonepay"/>
                <field name="fonepay_merchant_code" invisible="not use_fonepay"/>
            </group>
            </xpath>
        </field>
    </record>

</odoo>
